# Runtime
ENVIRONMENT=development
APP_NAME=PostX
APP_BASE_URL=http://localhost
API_BASE_URL=http://localhost/api/v1
CORS_ORIGINS=["http://localhost","http://localhost:3000"]
LOG_LEVEL=INFO
# Exact email that is activated and granted the admin role on first login.
BOOTSTRAP_ADMIN_EMAIL=

# Supabase (publishable values may be exposed to the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_STORAGE_BUCKET=postx-media
COOKIE_STORY_ENABLED=true

# PostgreSQL: use Supavisor transaction pooler for the API/workers.
DATABASE_URL=postgresql+asyncpg://postx_app:replace_me@pooler-host:6543/postgres
DATABASE_POOL_SIZE=8
DATABASE_MAX_OVERFLOW=4

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Application security
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace_with_32_byte_base64_key
INTERNAL_API_KEY=replace_with_random_internal_key

# Instagram API
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
INSTAGRAM_OAUTH_BASE_URL=https://www.instagram.com/oauth
TOKEN_RENEWAL_DAYS=7

# Frontend build/runtime
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
